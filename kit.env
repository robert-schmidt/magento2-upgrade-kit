# Defaults for every script. Override any of these with environment variables, e.g.
#   CUSTOM_PATHS="app/code app/design lib/Acme" MAGENTO_ROOT=/srv/shop/src steps/00-report.sh
# or put the assignments in a file and point KIT_ENV_FILE at it.
[[ -n "${KIT_ENV_FILE:-}" && -f "$KIT_ENV_FILE" ]] && source "$KIT_ENV_FILE"

# Magento root: the directory containing app/, bin/magento and the root composer.json
MAGENTO_ROOT="${MAGENTO_ROOT:-$PWD}"

# Your code, relative to MAGENTO_ROOT (space separated; missing entries are skipped).
# Add anything that holds PHP you own: extra lib/ namespaces, forked vendor copies, custom setup code, ...
CUSTOM_PATHS="${CUSTOM_PATHS:-app/code app/design}"

# Build/runtime files that reference the PHP version, relative to the git repo root (bin/infra.php)
INFRA_PATHS="${INFRA_PATHS:-Dockerfile docker .docker pipelines .github .gitlab-ci.yml bitbucket-pipelines.yml azure-pipelines.yml bin docker-compose.yml docker-compose.override.yml docker-compose.dev.yml}"

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Reports (outside the project by default)
REPORT_DIR="${REPORT_DIR:-$KIT_DIR/reports}"
# Isolated tool installs (Rector, PHPCompatibility, upgrade-patch-helper): never added to your composer.json
TOOLS_DIR="${TOOLS_DIR:-$KIT_DIR/.tools}"

# Target versions
M248_VERSION="${M248_VERSION:-2.4.8-p5}"
M249_VERSION="${M249_VERSION:-2.4.9}"
